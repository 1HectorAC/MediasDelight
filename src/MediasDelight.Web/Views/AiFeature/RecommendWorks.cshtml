@using System.Text.Json
@model List<MediaType>

@{
    ViewData["Title"] = " Recommend";
    ViewData["BodyClass"] = "other-page";
}

<div class="cardCenterContainer">
    <h2 class="fascinate-regular generalHeadline">@ViewData["Title"]</h2>
    <p class="generalSubHeadline">Generate a list with description of recommended works based on you media entries.</p>
    <p>
        / <a asp-action="UserDashboard" asp-controller="Home">Dashboard</a>
        / Recommend
    </p>
    <hr />

    <div style="display:flex; justify-content:center; flex-direction:column; align-items:center">
        <div>
            <p>Select a Media Type</p>
            @foreach (MediaType i in Model)
            {
                <div class="form-check">
                    <input type="radio" class="form-check-input" id="mediaType-@i.Id" name="mediaTypes" value=@i.Id />
                    @i.Name
                    <label class="form-check-label" for="mediaType-@i.Id"></label>
                </div>
            }
        </div>
        <span class="text-danger error"></span>
        <div>
            <br />
            <button id="submitButton" class="btn button1">Recommend Now!!!</button>
        </div>
    </div>
    <br />
    <div class="textLineDivider">
        <hr />
        <p>Results</p>
        <hr />
    </div>
    <p id="responseSection"></p>
</div>

<script>
    // DATA FORMATING: used in results section (indicate selection)
    var mediaTypes = @Html.Raw(JsonSerializer.Serialize(Model));

    var submitBtn = document.querySelector('#submitButton');
    submitBtn.addEventListener("click", e => {
        // DATA RETRIEVE: Get mediaType radio and mediaWorkName
        var radioChecked = document.querySelector('input[name="mediaTypes"]:checked');

        // VALIDATION: Check that mediaType radio and mediaWorkName text input are filled
        if (!radioChecked) {
            document.querySelector(".error").textContent = "Need to select a Media type";
        }
        else {
            document.querySelector(".error").textContent = "";
            var radioValue = radioChecked.value;

            // LOADING INDICATOR: modify some elements to indicate loading status
            var responseSection = document.querySelector("#responseSection");
            responseSection.textContent = "Loading...";
            submitBtn.disabled = true;

            fetch("/AiFeature/GenerateRecommendWorksResponse", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: radioValue
            }).then(async response => {
                if (!response.ok) {
                    const error = await response.text();
                    throw new Error(error);
                }
                return response.json();
            }).then(data => {
                // RESULTS: Set response text
                document.querySelector("#responseSection").textContent = data.response;

                // RESULT: Set MediaType indicator
                document.querySelector("#mediaTypeIndicator").textContent = mediaTypes.filter(i => i.Id == radioValue)[0].Name;

                // RESULT: Re-enable analyze button
                submitBtn.disabled = false;
            }).catch(err => {
                console.log("Fetch error: " + err.message);
            })
        }
    });

</script>