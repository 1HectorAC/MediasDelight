@using MediasDelight.Web.Models.ViewModels
@model MediaItemIndexPageViewModel

<h1> Media Items</h1>
<hr />
<h5 class="text-center">Add Item</h5>
<form asp-action="Add" asp-controller="MediaItem" method="post">
    <div class="row">
        <div class="col-md-3">
            <Label asp-for="AddItem.Name">Name</Label>
            <input asp-for="AddItem.Name" type="text" class="form-control" />
            <span asp-validation-for="AddItem.Name" class="text-danger"></span>
        </div>

        <div class="col-md-2">
            <Label asp-for="AddItem.MediaTypeId">MediaType</Label>
            @Html.DropDownListFor(n => n.AddItem.MediaTypeId,
        (SelectList)Model.MediaTypes,
        "Select Media Type", new { @class = "form-control" })
            <span asp-validation-for="AddItem.MediaTypeId" class="text-danger"></span>
        </div>
        <div class="col-md-1">
            <Label asp-for="AddItem.Rating">Rating</Label>
            <input asp-for="AddItem.Rating" type="number" max="10" min="0" class="form-control" />
            <span asp-validation-for="AddItem.Rating" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <Label asp-for="AddItem.Likes">Likes</Label>
            <input asp-for="AddItem.Likes" type="text" class="form-control" />
            <span asp-validation-for="AddItem.Likes" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <Label asp-for="AddItem.Dislikes">Dislikes</Label>
            <input asp-for="AddItem.Dislikes" type="text" class="form-control" />
            <span asp-validation-for="AddItem.Dislikes" class="text-danger"></span>
        </div>
        
        <div class="col-md-2 offset-5 text-center">
            <br/>
            <button class="btn btn-primary">Submit</button>
        </div>
    </div>
</form>

<hr />
<h5 class="text-center">All items</h5>
@foreach (MediaItemViewModel i in Model.Items)
{
    <p>Title: @i.Name, MediaTypeId: @i.MediaTypeName Rating: @i.Rating, Likes: @i.Likes, Dislikes: @i.Dislikes</p>
    <button class="btn btn-danger" onclick="showDeleteModal(@i.Id)">Delete</button>
}

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this item?
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>

    </div>
</div>

<script>
    function showDeleteModal(id) {
        document.getElementById("deleteForm").action = "/MediaItem/Delete/" + id;
        var modal = new bootstrap.Modal(document.getElementById("deleteModal"));
        modal.show();
    }
</script>