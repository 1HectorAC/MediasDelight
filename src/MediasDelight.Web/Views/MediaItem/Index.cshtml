@using MediasDelight.Web.Models.ViewModels
@model List<MediaItemViewModel>

@{
    ViewData["Title"] = "MediaItems Dashboard";
    ViewData["BodyClass"] = "other-page";
}

<h2 class="fascinate-regular generalHeadline">@ViewData["Title"]</h2>

<div class="cardCenterContainer">
    <div style="display:flex; justify-content:space-between">
        <p>/ <a asp-action="UserDashboard" asp-controller="Home">Dashboard</a> / MediaItems</p>
        <a asp-action="Create" asp-controller="MediaItem">
            <button class="btn button1">Add media Item</button>
        </a>

    </div>
    <br />
    <div style="text-align:center; display:flex">
        <hr style="width:33%" />
        <p style="width:33%">Media List</p>
        <hr style="width:33%" />
    </div>
    <br />
    <div style=" border: 1px solid rgb(190, 190, 190); padding: 10px">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <div style="width:80%">
                <input type="text" class="form-control" style="width: 70%; display:inline-block;" />
                <button class="btn button1" disabled>Enter</button>
            </div>
            <div><a class="orangeText" id="filterBtn">Filter -</a></div>
        </div>
        <div style="display:flex; gap:5px">
            <div class="filterLabel">Type:VideoGames</div>
            <div class="filterLabel">MaxRating:10</div>
            <div class="filterLabel">MinRating:0</div>
        </div>
        <div id="filtersSection" class="">
            <hr />
            <br />
            <div style="display:flex; gap:5px">
                <select class="form-select">
                    <option value="" disabled selected>Select Type</option>
                    <option>Video Game</option>
                    <option>Movie</option>
                </select>
                <select class="form-select">
                    <option value="0" selected>Min Rating</option>
                    @for (var i = 1; i <= 10; i++)
                    {
                        <option value=@i>@i</option>
                    }

                </select>
                <select class="form-select">
                    <option value="0" selected>Max Rating</option>
                    @for (var i = 1; i <= 10; i++)
                    {
                        <option value=@i>@i</option>
                    }
                </select>
                <button class="btn button1">Submit</button>
            </div>
            <br />

        </div>
    </div>
    <br />
    <div>
        <table class="table myTable">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Type</th>
                    <th scope="col">Rating</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (MediaItemViewModel i in Model)
                {
                    <tr class="myTableRow">
                        <td>@i.Name</td>
                        <td>@i.MediaTypeName</td>
                        <td>@i.Rating</td>
                        <td>
                            <a asp-action="Edit" asp-controller="MediaItem" asp-route-id=@i.Id><button class="btn button1">Info</button></a>
                            <button class="btn btn-danger" onclick="showDeleteModal(@i.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <br />
    <div style="display:flex; justify-content:center; align-items:center; gap: 5px">
        <button class="btn button1" disabled>Back</button>
        <p style="margin:0"> 1</p>
        <button class="btn button1" disabled>Next</button>
    </div>

</div>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this item?
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>

    </div>
</div>

<script>
    const filterBtn = document.querySelector("#filterBtn");
    const filtersSection = document.querySelector("#filtersSection");
    filterBtn.addEventListener("click", () => {
        filtersSection.classList.toggle("show");
    });
    function showDeleteModal(id) {
        document.getElementById("deleteForm").action = "/MediaItem/Delete/" + id;
        var modal = new bootstrap.Modal(document.getElementById("deleteModal"));
        modal.show();
    }
</script>