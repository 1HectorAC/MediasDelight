@using MediasDelight.Web.Models.ViewModels
@model MediaItemIndexPageViewModel

<h1> Index Media Item</h1>
<hr />
<h5>Add Item</h5>
<form asp-action="Add" asp-controller="MediaItem" method="post">
    <Label asp-for="AddItem.Name">Name</Label>
    <input asp-for="AddItem.Name" type="text" />
    <span asp-validation-for="AddItem.Name" class="text-danger"></span>

    @Html.DropDownListFor(n => n.AddItem.MediaTypeId,
        (SelectList)Model.MediaTypes,
        "Select Media Type", new { })
    <span asp-validation-for="AddItem.MediaTypeId" class="text-danger"></span>

    <Label asp-for="AddItem.Rating">Rating</Label>
    <input asp-for="AddItem.Rating" type="number" max="10" min="0" />
    <span asp-validation-for="AddItem.Rating" class="text-danger"></span>

    <Label asp-for="AddItem.Description">Description</Label>
    <input asp-for="AddItem.Description" type="text" />
    <span asp-validation-for="AddItem.Description" class="text-danger"></span>

    <button>Submit</button>
</form>

<hr />
<h5>List of items</h5>
@foreach (MediaItem i in Model.Items)
{
    <p>Title: @i.Name, MediaTypeId: @i.MediaTypeId Rating: @i.Rating, Desc: @i.Description</p>
    <button class="btn btn-danger" onclick="showDeleteModal(@i.Id)">Delete</button>
}

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this item?
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>

    </div>
</div>

<script>
    function showDeleteModal(id) {
        document.getElementById("deleteForm").action = "/MediaItem/Delete/" + id;
        var modal = new bootstrap.Modal(document.getElementById("deleteModal"));
        modal.show();
    }
</script>