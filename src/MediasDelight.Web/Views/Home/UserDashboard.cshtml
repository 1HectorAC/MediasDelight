@{
    ViewData["Title"] = "Dashboard";
    ViewData["BodyClass"] = "other-page";
}
<h2 class="fascinate-regular generalHeadline">@ViewData["Title"]</h2>

<div class="cardCenterContainer">
    <div style="display:flex; justify-content:space-between">
        <p>/ Dashboard</p>
        <a asp-action="Index" asp-controller="MediaItem">
            <button class="btn button1">Manage Media Items</button>
        </a>

    </div>
    <br />
    <div style="text-align:center; display:flex">
        <hr style="width:33%" />
        <p style="width:33%">AI Features Selection</p>
        <hr style="width:33%" />
    </div>
    <br />
    <div class="cardSection">
        <a asp-action="AnalyzeMe" asp-controller="AiFeature">
            <button class="btn button1 dashboardButton fascinate-regular">
                <span class="material-symbols-outlined cardIcon">sentiment_satisfied</span>
                Analyze Me
            </button>
        </a>
        <a asp-action="AssessWork" asp-controller="AiFeature">
            <button class="btn button1 dashboardButton fascinate-regular">
                <span class="material-symbols-outlined cardIcon">tv</span>
                Analyze Work
            </button>
        </a>

        <a asp-action="RecommendWorks" asp-controller="AiFeature">
            <button class="btn button1 dashboardButton fascinate-regular">
                <span class="material-symbols-outlined cardIcon">recommend</span>
                Recommend
            </button>
        </a>

        
        
    </div>

</div>


<br />
<br />
