@{
    ViewData["Title"] = "Home Page";
    ViewData["BodyClass"] = "home-page";
}

<section class="text-center home-hero">
    <span class="fascinate-regular heroHeaderText">Check Your Media.<br /> Check Yourself.</span>
    <p class="heroSubHeaderText">Learn more about what media you like and dislike with our AI Tools.</p>
    <a asp-area="Identity" asp-page="/Account/Register">
        <button class="btn button1 heroHeaderButton">Start Now</button>
    </a>

    
</section>

<p class="text-center pt-4 pb-3">What can AI do for you?</p>

<div class="cardSection">
    <div class="cardInfo">
        <div>
            <span class="material-symbols-outlined cardIcon">sentiment_satisfied</span>
        </div>
        <span class="fascinate-regular cardHeadline">Analyze Me</span>
        <p class="greyText cardText">Let AI analyze what you like/dislike and describe who you are</p>
    </div>
    <div class="cardInfo">
        <div>
            <span class="material-symbols-outlined cardIcon">tv</span>
        </div>
        <span class="fascinate-regular cardHeadline">Assess Work</span>
        <p class="greyText cardText">Gain insight on how much you will enjoy a work before even watching it</p>
    </div>
    <div class="cardInfo">
        <div>
            <span class="material-symbols-outlined cardIcon">recommend</span>
        </div>
        <span class="fascinate-regular cardHeadline">Recommend</span>
        <p class="greyText cardText">Get a list of works that you might like based on your media history</p>
    </div>
</div>
